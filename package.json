    "decode-uri-component": "0.5.1",
    "glob@>=9": "14.0.4",
    "cookie@<0.7": "0.7.2",
    "chokidar@<3": "3.6.0",
    "nconf": "0.12.1",
    "minimist": "1.2.8"
