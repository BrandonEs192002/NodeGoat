{
  "name": "owasp-nodejs-goat",
  "private": true,
  "version": "1.3.0",
  "description": "A tool to learn OWASP Top 10 for node.js developers",
  "main": "server.js",
  "dependencies": {
    "bcrypt-nodejs": "0.0.3",
    "body-parser": "1.20.9",
    "bootstrap": "4.6.2",
    "bootstrap-tourist": "0.3.2",
    "consolidate": "1.0.4",
    "csurf": "1.11.0",
    "dont-sniff-mimetype": "1.1.0",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "forever": "4.0.3",
    "helmet": "8.3.0",
    "jquery": "3.7.1",
    "marked": "4.3.0",
    "mongodb": "3.7.4",
    "needle": "3.5.0",
    "node-esapi": "0.0.1",
    "nunjucks": "3.2.4",
    "serve-favicon": "2.5.1",
    "underscore": "1.13.8"
  },
  "comments": {
    "//": "a9 insecure components"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env PORT=5000 nodemon",
    "test:e2e": "cross-env NODE_ENV=test cypress open",
    "test:ci": "cross-env NODE_ENV=test cypress run",
    "test": "node node_modules/grunt-cli/bin/grunt test",
    "db:seed": "cross-env NODE_ENV=test grunt db-reset",
    "precommit": "grunt precommit",
    "docker-mongo": "docker run -p 27017:27017 --name mongo  mongo:latest",
    "start-infra": "docker-compose up",
    "stop-infra": "docker-compose down",
    "cy:verify": "cypress verify"
  },
  "devDependencies": {
    "async": "3.2.6",
    "cross-env": "7.0.3",
    "cypress": "16.3.0",
    "grunt": "1.6.3",
    "grunt-cli": "1.5.0",
    "grunt-concurrent": "3.0.0",
    "grunt-contrib-jshint": "^3.0.0",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-env": "latest",
    "grunt-jsbeautifier": "^0.2.12",
    "grunt-mocha-test": "0.13.3",
    "jshint": "2.13.6",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "retire": "6.1.0",
    "selenium-webdriver": "4.51.0",
    "should": "13.2.3",
    "zaproxy": "2.0.0-rc.7"
  },
  "repository": "https://github.com/OWASP/NodejsGoat",
